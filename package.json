{
  "name": "cg-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "qa": "node tools/qa/run-all.mjs",
    "qa:fast": "node tools/qa/run-all.mjs --fast",
    "qa:browser": "vite build && node tools/qa/browser-qa.mjs --serve",
    "qa:report": "node tools/qa/report.mjs",
    "launch:covers": "vite build && node tools/launch/capture-covers.mjs --serve",
    "launch:video": "vite build && node tools/launch/record-preview.mjs --serve",
    "launch:check": "node tools/launch/check-submission.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.3.0"
  }
}
